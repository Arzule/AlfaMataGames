# Variables de producción en la VM (copiar a deploy/.env). Nunca commitear valores reales.
DOMAIN=alfamatagames-api.chilecentral.cloudapp.azure.com
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=alfamatagames
MYSQL_USER=
MYSQL_PASSWORD=
# Mínimo 32 caracteres: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Orígenes web permitidos por CORS separados por comas (vacío = cualquiera).
CORS_ORIGINS=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
DEEPL_API_KEY=
