# Variables de producción en la VM (copiar a deploy/.env). Nunca commitear valores reales.
DOMAIN=alfamatagames-api.chilecentral.cloudapp.azure.com
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=alfamatagames
MYSQL_USER=
MYSQL_PASSWORD=
# Mínimo 32 caracteres: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Orígenes web permitidos por CORS separados por comas (vacío = cualquiera).
CORS_ORIGINS=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
DEEPL_API_KEY=
# Login social (opcional: sin credenciales no se ofrece el proveedor).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=https://alfamatagames-api.chilecentral.cloudapp.azure.com
OAUTH_WEB_REDIRECTS=https://alfamatagames-api.chilecentral.cloudapp.azure.com/oauth
# true mientras se pruebe con Expo Go contra producción; false con el APK.
OAUTH_ALLOW_EXPO_GO=true
