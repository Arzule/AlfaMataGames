# Plantilla de variables de entorno. Copia este archivo a .env y completa los valores reales.

# Credenciales de IGDB (https://api-docs.igdb.com): aplicación de Twitch en dev.twitch.tv
# (Client Type: Confidential). Solo las usa el backend: la app pide el catálogo al backend
# y nunca las conoce.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Clave de DeepL API Free (https://www.deepl.com/pro-api) para traducir las sinopsis.
# Solo la usa el backend. Las claves Free terminan en ":fx". Si queda vacía, la app
# muestra la sinopsis original con una etiqueta.
DEEPL_API_KEY=
# Opcional: fuerza el endpoint de DeepL (por defecto se elige según la clave).
DEEPL_API_URL=

# URL base del backend para la app. Usa la IP local de tu PC, no localhost,
# porque el celular no puede resolver localhost (ej. http://192.168.1.10:3000).
# El prefijo EXPO_PUBLIC_ hace que Expo la incluya en la app (no pongas secretos aquí).
EXPO_PUBLIC_API_URL=

# --- Base de datos MySQL ---
# Contraseña del usuario root de MySQL
MYSQL_ROOT_PASSWORD=
# Nombre de la base de datos a crear
MYSQL_DATABASE=
# Usuario de la aplicación
MYSQL_USER=
# Contraseña del usuario de la aplicación
MYSQL_PASSWORD=
# Puerto del host para acceder a la base de datos de Docker
# (se usa 3307 para no chocar con un MySQL local en 3306)
DB_HOST_PORT=3307

# --- Conexión a la BD en la nube (opcional; Azure u otro proveedor) ---
# Si se define una URL, el backend la usa en lugar de las variables sueltas.
# En local con Docker Compose no hace falta: docker-compose.yml no las pasa al backend.
# Formato: mysql://usuario:contraseña@host:puerto/base_de_datos
DATABASE_URL=
# Alternativa con el nombre que usan otros proveedores (se usa si DATABASE_URL está vacía).
MYSQL_URL=
# true para conectar con SSL (por defecto false)
DB_SSL=false
# false para aceptar certificados autofirmados con SSL (por defecto true)
DB_SSL_REJECT_UNAUTHORIZED=true

# --- Autenticación JWT ---
# Clave secreta para firmar los tokens
JWT_SECRET=
# Tiempo de expiración del token (ej. 7d)
JWT_EXPIRES_IN=7d

# Puerto en el que escucha el backend (ej. 3000)
BACKEND_PORT=3000

# Nivel mínimo de los logs del backend: debug, info, warn o error (por defecto info).
# En debug también se registran /health y los preflight de CORS.
LOG_LEVEL=info
